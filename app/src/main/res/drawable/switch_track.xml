<?xml version="1.0" encoding="utf-8"?>
<!-- The switch's track: filled with the accent when on, outlined when off -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/switch_radius" />
            <size android:width="@dimen/switch_width" android:height="@dimen/switch_height" />
            <solid android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/switch_radius" />
            <size android:width="@dimen/switch_width" android:height="@dimen/switch_height" />
            <solid android:color="@color/surface_2" />
            <stroke android:width="2dp" android:color="@color/text_mute" />
        </shape>
    </item>
</selector>
