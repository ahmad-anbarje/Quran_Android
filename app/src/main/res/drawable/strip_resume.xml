<?xml version="1.0" encoding="utf-8"?>
<!-- Resume strip: the reader's own chrome colour, so it stands apart from the nav and leads into the reader; a ripple, since it is tappable -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_soft">
    <item>
        <layer-list>
            <item android:drawable="@color/reader_chrome" />
            <item
                android:drawable="@color/line"
                android:gravity="top"
                android:height="1dp" />
        </layer-list>
    </item>
</ripple>
