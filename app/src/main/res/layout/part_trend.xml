<?xml version="1.0" encoding="utf-8"?>
<!-- This week against the week before: an arrow up or down, and by how much. Filled by showTrend() -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/chip_soft"
    android:paddingStart="8dp"
    android:paddingEnd="10dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/trend_icon"
        android:layout_width="@dimen/trend_icon"
        android:layout_height="@dimen/trend_icon"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/trend_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@color/accent"
        android:textSize="@dimen/row_meta"
        android:includeFontPadding="false"
        android:maxLines="1" />
</LinearLayout>
