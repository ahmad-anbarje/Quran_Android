<?xml version="1.0" encoding="utf-8"?>
<!-- On which days: a label, then the seven days of the week, Saturday first -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="@dimen/row_pad_v"
    android:paddingBottom="@dimen/row_pad_v">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/goal_on_days"
        android:textColor="@color/text"
        android:textSize="@dimen/row_title" />

    <LinearLayout
        android:id="@+id/goal_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />
</LinearLayout>
