<?xml version="1.0" encoding="utf-8"?>
<!-- One small statistic: an icon in its disc, the figure, what it counts -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:background="@drawable/card_group"
    android:minHeight="@dimen/tile_min_height"
    android:padding="@dimen/tile_pad">

    <FrameLayout
        android:layout_width="@dimen/tile_disc"
        android:layout_height="@dimen/tile_disc"
        android:background="@drawable/chip_soft">

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="@dimen/tile_icon"
            android:layout_height="@dimen/tile_icon"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/tile_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text"
        android:textSize="@dimen/tile_value"
        android:textStyle="bold"
        android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="@dimen/tile_value_min"
        app:autoSizeMaxTextSize="@dimen/tile_value" />

    <TextView
        android:id="@+id/tile_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_mute"
        android:textSize="@dimen/row_meta"
        android:maxLines="2" />

    <include
        android:id="@+id/tile_trend"
        layout="@layout/part_trend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone" />
</LinearLayout>
