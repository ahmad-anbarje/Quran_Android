<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. DUMP is held by adb's shell and by no app, so only the developer's computer can send it -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".SampleStats"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
