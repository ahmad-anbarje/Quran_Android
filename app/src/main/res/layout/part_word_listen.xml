<?xml version="1.0" encoding="utf-8"?>
<!-- Hear the word on its own: an outlined icon button under the word in the Tajweed card -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/word_listen"
    android:layout_width="@dimen/word_listen"
    android:layout_height="@dimen/word_listen"
    android:background="@drawable/chip_outline"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/label_word">

    <ImageView
        android:id="@+id/word_listen_icon"
        android:layout_width="@dimen/quarter_icon"
        android:layout_height="@dimen/quarter_icon"
        android:layout_gravity="center"
        android:src="@drawable/ic_word_play"
        android:contentDescription="@null" />
</FrameLayout>
