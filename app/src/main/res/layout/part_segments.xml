<?xml version="1.0" encoding="utf-8"?>
<!-- Four segments over a pager, for the index and achievements alike; SwipeTabs names and marks them -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:layoutDirection="locale"
    android:background="@drawable/strip_head"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <include
        android:id="@+id/seg_1"
        layout="@layout/part_seg"
        android:layout_width="0dp"
        android:layout_height="@dimen/seg_height"
        android:layout_weight="1" />

    <include
        android:id="@+id/seg_2"
        layout="@layout/part_seg"
        android:layout_width="0dp"
        android:layout_height="@dimen/seg_height"
        android:layout_weight="1"
        android:layout_marginStart="6dp" />

    <include
        android:id="@+id/seg_3"
        layout="@layout/part_seg"
        android:layout_width="0dp"
        android:layout_height="@dimen/seg_height"
        android:layout_weight="1"
        android:layout_marginStart="6dp" />

    <include
        android:id="@+id/seg_4"
        layout="@layout/part_seg"
        android:layout_width="0dp"
        android:layout_height="@dimen/seg_height"
        android:layout_weight="1"
        android:layout_marginStart="6dp" />
</LinearLayout>
