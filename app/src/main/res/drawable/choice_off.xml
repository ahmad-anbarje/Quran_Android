<?xml version="1.0" encoding="utf-8"?>
<!-- A button or tile not chosen: outlined, so it still reads as something to tap -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/choice_radius" />
    <solid android:color="@color/surface" />
    <stroke android:width="1.5dp" android:color="@color/accent_soft" />
</shape>
