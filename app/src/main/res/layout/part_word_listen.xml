<?xml version="1.0" encoding="utf-8"?>
<!-- Hear the word on its own: an outlined chip under the word in the Tajweed card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/word_listen"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/quarter_chip_height"
    android:layout_gravity="center_horizontal"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:layoutDirection="locale"
    android:background="@drawable/chip_outline"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/word_listen_icon"
        android:layout_width="@dimen/quarter_icon"
        android:layout_height="@dimen/quarter_icon"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_word_play"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/word_listen_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_word"
        android:textColor="@color/text"
        android:textSize="@dimen/text_body" />
</LinearLayout>
