<?xml version="1.0" encoding="utf-8"?>
<!-- The switch's knob: large and light when on, small and muted when off; both sit in the track's height -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="@dimen/switch_height" android:height="@dimen/switch_height">
                <shape android:shape="oval"><solid android:color="#00000000" /></shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="oval"><solid android:color="@color/on_dark" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="@dimen/switch_height" android:height="@dimen/switch_height">
                <shape android:shape="oval"><solid android:color="#00000000" /></shape>
            </item>
            <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
                <shape android:shape="oval"><solid android:color="@color/text_mute" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
