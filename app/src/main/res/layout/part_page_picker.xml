<?xml version="1.0" encoding="utf-8"?>
<!-- Pages as tiles to tick, with the buttons kept in view below them -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:background="@drawable/sheet"
    android:paddingTop="10dp"
    android:paddingBottom="14dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/grip" />

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/text"
        android:textSize="@dimen/row_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/picker_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/text_mute"
        android:textSize="@dimen/row_meta" />

    <ScrollView
        android:id="@+id/picker_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/picker_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/picker_all"
            android:layout_width="0dp"
            android:layout_height="@dimen/choice_tile"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:background="@drawable/choice_off"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/text"
            android:textSize="@dimen/row_title" />

        <TextView
            android:id="@+id/picker_done"
            android:layout_width="0dp"
            android:layout_height="@dimen/choice_tile"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/choice_on"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/hifz_keep"
            android:textColor="@color/on_dark"
            android:textSize="@dimen/row_title"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
