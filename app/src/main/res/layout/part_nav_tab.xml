<?xml version="1.0" encoding="utf-8"?>
<!-- One bottom-navigation tab: icon in its pill, label under it; the label shrinks rather than clips. Set by choose() -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="28dp"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/nav_icon"
            android:contentDescription="@null"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:duplicateParentState="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/nav_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:duplicateParentState="true"
        android:maxLines="1"
        android:textSize="@dimen/nav_label"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="@dimen/icon_label_min"
        app:autoSizeMaxTextSize="@dimen/nav_label" />
</LinearLayout>
