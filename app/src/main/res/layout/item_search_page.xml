<?xml version="1.0" encoding="utf-8"?>
<!-- Page result: opens the page, or recites from it, as a surah row does -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:layoutDirection="locale"
    android:background="@drawable/row_bg"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="6dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="@dimen/num_disc"
        android:layout_height="@dimen/num_disc"
        android:background="@drawable/chip_soft">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_surahs"
            android:tint="@color/accent"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Padding here so the buttons can match the full row height -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:paddingTop="@dimen/row_pad_v"
        android:paddingBottom="@dimen/row_pad_v"
        android:orientation="vertical">

        <TextView
            android:id="@+id/page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textSize="@dimen/row_title"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/page_where"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_mute"
            android:includeFontPadding="false"
            android:textSize="@dimen/row_meta"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <include layout="@layout/part_row_actions" />
</LinearLayout>
