<?xml version="1.0" encoding="utf-8"?>
<!-- A section of the achievements tab: larger than a card's title, so the sections read as separate -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/section_inset"
    android:paddingEnd="@dimen/section_inset"
    android:paddingTop="@dimen/section_gap"
    android:textColor="@color/text"
    android:textSize="@dimen/section_title"
    android:textStyle="bold" />
