<?xml version="1.0" encoding="utf-8"?>
<!-- Night palette: a dark page in the app's blue-grey family, with near-white type -->
<resources>
    <color name="paper">#151A1E</color>
    <!-- Near-white, short of white, which glares and blooms on a dark screen -->
    <color name="ink">#DDE2E7</color>
    <!-- Night grounds step up as things rise: list, screen, page, card and sheet, reader bars -->
    <!-- Deeper than the page, so a list and a page are told apart at a glance -->
    <color name="list_ground">#0D1114</color>

    <color name="accent">#3F9BD1</color>
    <!-- Soft fills need more alpha on a dark ground to stay visible -->
    <color name="accent_soft">#4D3F9BD1</color>
    <!-- Cards and sheets: clearly above both the lists and the page -->
    <color name="surface">#1D242B</color>
    <!-- Lighter than the page at night, as raised things look on a dark screen. -->
    <color name="reader_chrome">#242C35</color>
    <color name="surface_2">#11161A</color>
    <color name="line">#323C47</color>
    <color name="text">#DDE2E7</color>
    <color name="text_mute">#B2B9C0</color>
    <!-- Knocked out of the filled pill. Not pure white at night: it glares. -->
    <color name="on_dark">#0F1317</color>
    <!-- Lit word at night: amber, the one hue that reads as coloured beside near-white type, at its brightness -->
    <color name="ink_lit">#FFD479</color>
    <!-- Quieter than the lit word, so the markers never read as the recited one -->
    <color name="ayah_mark">#579FD1</color>
</resources>
